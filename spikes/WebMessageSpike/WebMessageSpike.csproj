<Project Sdk="Microsoft.NET.Sdk">

  <!--
    独立 Spike：WebMessage 通信链路验证（docs/product-design.md §4.4）。
    不加入 Apage.sln；构建：dotnet build spikes/WebMessageSpike/WebMessageSpike.csproj
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Apage.Spikes.WebMessage</RootNamespace>
    <AssemblyName>WebMessageSpike</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <ItemGroup>
    <!-- 注入脚本作为嵌入资源，运行时从程序集读取 -->
    <EmbeddedResource Include="bridge.js" />
    <!-- 测试页（经虚拟主机名映射访问，离线可复现） -->
    <None Update="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
