<Window x:Class="Apage.Spikes.SingleFile.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Apage SingleFile Spike" Width="840" Height="520"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="StatusText" Margin="16,12" FontSize="15"
                   Text="正在验证单文件、SQLite 与 WebView2…" />
        <Border Grid.Row="1" Margin="16,0,16,16" Background="White"
                BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="8">
            <wv2:WebView2 x:Name="WebView" />
        </Border>
    </Grid>
</Window>
