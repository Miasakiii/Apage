<Application x:Class="Apage.Portable.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 无 StartupUri：启动流程改由 App.OnStartup 手动装配（单实例判定 + 设置加载 + 依赖注入 MainWindow） -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 令牌（画刷经 DynamicResource 引用主题色值） -->
                <ResourceDictionary Source="Themes/Tokens.xaml"/>
                <!-- 主题色值：默认浅色；切换深色时用 Dark.xaml 替换本行 -->
                <ResourceDictionary Source="Themes/Light.xaml"/>
                <!-- 基础控件样式 -->
                <ResourceDictionary Source="Themes/Controls.xaml"/>
                <!-- 线性图标库（StreamGeometry + 图标 Path 样式） -->
                <ResourceDictionary Source="Themes/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
