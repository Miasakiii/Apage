  <!--
    Wildcard includes ON PURPOSE: parallel agents add .cs / .xaml / asset files
    WITHOUT editing this csproj. Everything under the project directory is picked
    up automatically, except obj\ and bin\. App.xaml stays an ApplicationDefinition
    and is therefore excluded from the Page glob. Do not replace these globs with
    per-file entries.
  -->
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Compile Include="**\*.cs" Exclude="obj\**;bin\**" />
    <Page Include="**\*.xaml" Exclude="App.xaml;obj\**;bin\**" />
    <Resource Include="Assets\**" Exclude="Assets\**\.gitkeep" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Apage.Core\Apage.Core.csproj">
