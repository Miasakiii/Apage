<UserControl x:Class="Apage.Portable.Controls.WindowButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      窗口控制按钮（frontend-design.md §5.1）：最小化/最大化/关闭，
      融入标签条右端，46x36，hover 圆角块；关闭 hover #E81123 白字。
    -->
    <UserControl.Resources>
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Apage.Brush.TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid WindowChrome.IsHitTestVisibleInChrome="True">
                            <Border x:Name="Bg" Margin="4" CornerRadius="8" Background="Transparent"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource Apage.Brush.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource Apage.Brush.Pressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 关闭按钮：hover #E81123 白字（规范指定字面值） -->
        <Style x:Key="CloseWindowButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid WindowChrome.IsHitTestVisibleInChrome="True">
                            <Border x:Name="Bg" Margin="4" CornerRadius="8" Background="Transparent"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C50F1F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal">
        <!-- 图标用字符占位，后续换内嵌 StreamGeometry 图标体系 -->
        <Button x:Name="MinButton" Style="{StaticResource WindowButtonStyle}"
                Content="─" ToolTip="最小化" Click="MinButton_Click"/>
        <Button x:Name="MaxButton" Style="{StaticResource WindowButtonStyle}"
                Content="▢" ToolTip="最大化" Click="MaxButton_Click"/>
        <Button x:Name="CloseButton" Style="{StaticResource CloseWindowButtonStyle}"
                Content="✕" ToolTip="关闭" Click="CloseButton_Click"/>
    </StackPanel>
</UserControl>
