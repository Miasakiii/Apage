<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Apage 基础控件样式（docs/frontend-design.md §10.1）
        - 颜色一律 DynamicResource 引用 Apage.Brush.* 令牌，禁止内联色值。
        - 变色过渡统一 100ms（dur-fast 令牌）；为避免改动共享画刷资源，
          一律用「叠层 Border + Opacity 动画」做 hover/pressed/focus 过渡（只动 Opacity/RenderTransform）。
        - 阴影用 Border 模拟（禁用 DropShadowEffect）。
    -->

    <!-- ================= Button（常规，隐式默认样式） ================= -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Apage.FontFamily.Base}"/>
        <Setter Property="FontSize" Value="{DynamicResource Apage.FontSize.Base}"/>
        <Setter Property="Foreground" Value="{DynamicResource Apage.Brush.TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource Apage.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Apage.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- 底层：常态 -->
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Apage.CornerRadius.Md}"
                                SnapsToDevicePixels="True"/>
                        <!-- 叠层：hover / pressed（只动 Opacity） -->
                        <Border x:Name="HoverBd" Background="{DynamicResource Apage.Brush.Hover}"
                                CornerRadius="{DynamicResource Apage.CornerRadius.Md}" Opacity="0"/>
                        <Border x:Name="PressedBd" Background="{DynamicResource Apage.Brush.Pressed}"
                                CornerRadius="{DynamicResource Apage.CornerRadius.Md}" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBd" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBd" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedBd" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedBd" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Apage.Brush.TextTertiary}"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 图标按钮 32x32 圆角 8（工具栏按钮，§5.4） ================= -->
    <Style x:Key="Apage.Style.Button.Icon" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ================= Toggle 开关 48x26 胶囊（§7.1） ================= -->
    <Style x:Key="Apage.Style.Toggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <!-- 轨道：关态底 + 开态 accent 叠层 -->
                        <Border x:Name="Track" Background="{DynamicResource Apage.Brush.Pressed}"
                                CornerRadius="13" SnapsToDevicePixels="True"/>
                        <Border x:Name="TrackOn" Background="{DynamicResource Apage.Brush.Accent}"
                                CornerRadius="13" Opacity="0"/>
                        <!-- 滑块：白色圆点，滑动只动 RenderTransform -->
                        <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White"
                                 HorizontalAlignment="Left" Margin="3,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="ThumbMove" X="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="22" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= ScrollBar 细条 6px 半透明 ================= -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <!-- ScrollBar 本身无 IsDirectionReversed；竖向默认 true，横向由下方触发器置 false（与系统模板一致） -->
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBd" CornerRadius="3"
                                                    Background="{DynamicResource Apage.Brush.TextTertiary}"
                                                    Opacity="0.35"/>
                                            <!-- hover 加深：元素级 Triggers 仅支持 EventTrigger，故放在模板触发器内 -->
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbBd" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.1"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbBd" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.1"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="Width" Value="6"/>
                        </Trigger>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="6"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= ContextMenu 圆角 8 + 阴影（Border 模拟） ================= -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Apage.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Apage.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="FontFamily" Value="{DynamicResource Apage.FontFamily.Base}"/>
        <Setter Property="FontSize" Value="{DynamicResource Apage.FontSize.Base}"/>
        <Setter Property="Foreground" Value="{DynamicResource Apage.Brush.TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- 外层 Border 模拟 shadow-2（0 8px 24px rgba(0,0,0,.16)） -->
                    <Border Padding="0,2,4,6" Background="Transparent">
                        <Border x:Name="ShadowBd" CornerRadius="10" Background="{DynamicResource Apage.Brush.Shadow2}" Margin="0,2,0,0">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource Apage.CornerRadius.Md}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MenuItem：项高 28，hover 圆角块，禁用项三级文字色 -->
    <Style TargetType="MenuItem">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Foreground" Value="{DynamicResource Apage.Brush.TextPrimary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Apage.FontFamily.Base}"/>
        <Setter Property="FontSize" Value="{DynamicResource Apage.FontSize.Base}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <!-- ControlTemplate 只允许单一根元素，用 Grid 包裹内容/悬停叠层/弹出层 -->
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource Apage.CornerRadius.Sm}"
                                Padding="8,0" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" SharedSizeGroup="MenuItemIcon"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Content="{TemplateBinding Icon}" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="2" Content="{TemplateBinding Header}"
                                                  VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                <!-- 子菜单箭头 -->
                                <Path x:Name="Arrow" Grid.Column="3" Width="6" Height="10" Stretch="Fill"
                                      Data="M0,0 L6,5 L0,10 Z" Fill="{DynamicResource Apage.Brush.TextSecondary}"
                                      VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <!-- 悬停叠层 -->
                        <Border x:Name="HoverBd" Background="{DynamicResource Apage.Brush.Hover}"
                                CornerRadius="{DynamicResource Apage.CornerRadius.Sm}" Opacity="0" IsHitTestVisible="False"/>
                        <!-- 子菜单弹出层 -->
                        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-2"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Padding="0,2,4,6" Background="Transparent">
                                <Border CornerRadius="10" Background="{DynamicResource Apage.Brush.Shadow2}" Margin="0,2,0,0">
                                    <Border Background="{DynamicResource Apage.Brush.Surface}"
                                            BorderBrush="{DynamicResource Apage.Brush.Border}" BorderThickness="1"
                                            CornerRadius="{DynamicResource Apage.CornerRadius.Md}" Padding="4">
                                        <ScrollViewer CanContentScroll="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </ScrollViewer>
                                    </Border>
                                </Border>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="PART_Popup" Property="IsOpen" Value="True"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBd" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBd" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Apage.Brush.TextTertiary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= ToolTip ================= -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Apage.Brush.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Apage.Brush.TextPrimary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Apage.FontFamily.Base}"/>
        <Setter Property="FontSize" Value="{DynamicResource Apage.FontSize.Sm}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Padding="0,1,2,3" Background="Transparent">
                        <Border CornerRadius="8" Background="{DynamicResource Apage.Brush.Shadow1}" Margin="0,1,0,0">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource Apage.Brush.Border}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Apage.CornerRadius.Md}"
                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter/>
                            </Border>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= TextBox 圆角 + 聚焦 accent 边 ================= -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Apage.FontFamily.Base}"/>
        <Setter Property="FontSize" Value="{DynamicResource Apage.FontSize.Base}"/>
        <Setter Property="Foreground" Value="{DynamicResource Apage.Brush.TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource Apage.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Apage.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Apage.Brush.Accent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Apage.Brush.AccentSoft}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Apage.CornerRadius.Md}"
                                SnapsToDevicePixels="True"/>
                        <!-- 聚焦 accent 边（叠层淡入，100ms） -->
                        <Border x:Name="FocusBd" BorderBrush="{DynamicResource Apage.Brush.Accent}"
                                BorderThickness="1.5" CornerRadius="{DynamicResource Apage.CornerRadius.Md}"
                                Opacity="0" IsHitTestVisible="False"/>
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusBd" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusBd" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Apage.Brush.TextTertiary}"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
