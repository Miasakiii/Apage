<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色主题色值（docs/frontend-design.md §4.1），key 与 Dark.xaml 一一对应 -->
    <Color x:Key="Apage.Color.WindowBg">#F7F8FA</Color>
    <Color x:Key="Apage.Color.Surface">#FFFFFF</Color>
    <Color x:Key="Apage.Color.Hover">#0D000000</Color><!-- rgba(0,0,0,.05) -->
    <Color x:Key="Apage.Color.Pressed">#17000000</Color><!-- rgba(0,0,0,.09) -->
    <Color x:Key="Apage.Color.TextPrimary">#1F2329</Color>
    <Color x:Key="Apage.Color.TextSecondary">#6B7280</Color>
    <Color x:Key="Apage.Color.TextTertiary">#9CA3AF</Color>
    <Color x:Key="Apage.Color.Border">#14000000</Color><!-- rgba(0,0,0,.08) -->
</ResourceDictionary>
