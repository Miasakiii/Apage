    <!-- 全屏（四角箭头） -->
    <StreamGeometry x:Key="Apage.Geo.Fullscreen">M4,9 L4,4 L9,4 M15,4 L20,4 L20,9 M20,15 L20,20 L15,20 M9,20 L4,20 L4,15</StreamGeometry>
    <!-- 音量（喇叭+声波） -->
    <StreamGeometry x:Key="Apage.Geo.Volume">M4,9 L4,15 L8,15 L13,20 L13,4 L8,9 Z M16.5,8.5 C18,10 18,14 16.5,15.5</StreamGeometry>
    <!-- 静音（喇叭+X） -->
    <StreamGeometry x:Key="Apage.Geo.Mute">M4,9 L4,15 L8,15 L13,20 L13,4 L8,9 Z M16,9 L21,14 M21,9 L16,14</StreamGeometry>
    <!-- 图钉 -->
    <StreamGeometry x:Key="Apage.Geo.Pin">M9,4 L15,4 L15,9 L19,13 L5,13 L9,9 Z M12,13 L12,21</StreamGeometry>
    <!-- 复制（两矩形） -->
    <StreamGeometry x:Key="Apage.Geo.Copy">M9,9 L9,21 L21,21 L21,9 Z M5,15 L3,15 L3,3 L15,3 L15,5</StreamGeometry>
    <!-- 删除（垃圾桶） -->
    <StreamGeometry x:Key="Apage.Geo.Trash">M4,7 L20,7 M9,7 L9,4 L15,4 L15,7 M6,7 L6,21 L18,21 L18,7 M10,11 L10,17 M14,11 L14,17</StreamGeometry>
    <!-- 编辑（铅笔） -->
    <StreamGeometry x:Key="Apage.Geo.Edit">M4,20 L4,16 L16,4 L20,8 L8,20 Z M14,6 L18,10</StreamGeometry>
    <!-- 信息（圆圈+i） -->
    <StreamGeometry x:Key="Apage.Geo.Info">M12,3 A9,9 0 1,0 12,21 A9,9 0 1,0 12,3 M12,11 L12,16 M12,8 L12,8.01</StreamGeometry>
    <!-- 主页（房子） -->
    <StreamGeometry x:Key="Apage.Geo.Home">M3,11 L12,3 L21,11 M5,10 L5,21 L19,21 L19,10</StreamGeometry>
    <!-- 扩展（拼图块） -->
    <StreamGeometry x:Key="Apage.Geo.Puzzle">M9,3 L15,3 L15,7 C16,7 17,8 17,9 C17,10 16,11 15,11 L15,15 L19,15 L19,11 C20,11 21,12 21,13 C21,14 20,15 19,15 L19,21 L13,21 C13,20 12,19 11,19 C10,19 9,20 9,21 L3,21 L3,15 C4,15 5,14 5,13 C5,12 4,11 3,11 L3,3 Z</StreamGeometry>
    <!-- 下拉箭头 -->
    <StreamGeometry x:Key="Apage.Geo.ChevronDown">M6,9 L12,15 L18,9</StreamGeometry>
    <!-- 右箭头 -->
    <StreamGeometry x:Key="Apage.Geo.ChevronRight">M9,6 L15,12 L9,18</StreamGeometry>
    <!-- 外部链接 -->
    <StreamGeometry x:Key="Apage.Geo.ExternalLink">M14,4 L20,4 L20,10 M20,4 L11,13 M9,5 L5,5 L5,19 L19,19 L19,15</StreamGeometry>
    <!-- 竖排三点菜单 -->
    <StreamGeometry x:Key="Apage.Geo.MoreVertical">M12,7.5 A0.75,0.75 0 1,0 12.01,7.5 M12,11.25 A0.75,0.75 0 1,0 12.01,11.25 M12,15 A0.75,0.75 0 1,0 12.01,15</StreamGeometry>
    <!-- 隐私盾+勾选 -->
    <StreamGeometry x:Key="Apage.Geo.ShieldCheck">M12,3 L19,6 L19,11 C19,15.5 16,18.5 12,20 C8,18.5 5,15.5 5,11 L5,6 Z M9,11.5 L11,13.5 L15,9.5</StreamGeometry>
    <!-- 警告三角 -->
    <StreamGeometry x:Key="Apage.Geo.Warning">M12,4 L22,20 L2,20 Z M12,10 L12,14 M12,17 L12,17.01</StreamGeometry>
    <!-- Cookie -->
    <StreamGeometry x:Key="Apage.Geo.Cookie">M12,3 A9,9 0 1,0 12,21 A9,9 0 1,0 12,3 M9,8 L9.01,8 M15,9 L15.01,9 M8,14 L8.01,14 M14,15 L14.01,15</StreamGeometry>
    <!-- 地球/网络 -->
    <StreamGeometry x:Key="Apage.Geo.Globe">M12,3 A9,9 0 1,0 12,21 A9,9 0 1,0 12,3 M3,12 L21,12 M12,3 C7,8 7,16 12,21 M12,3 C17,8 17,16 12,21</StreamGeometry>
    <!-- 向上箭头（NTP 搜索提交） -->
    <StreamGeometry x:Key="Apage.Geo.ArrowUp">M12,19 L12,5 M5,12 L12,5 L19,12</StreamGeometry>
    <!-- 文件夹 -->
    <StreamGeometry x:Key="Apage.Geo.Folder">M3,5 L10,5 L12,8 L21,8 L21,19 L3,19 Z</StreamGeometry>
    <!-- 新标签页（方框+加号） -->
    <StreamGeometry x:Key="Apage.Geo.NewTab">M5,5 L19,5 L19,19 L5,19 Z M12,9 L12,15 M9,12 L15,12</StreamGeometry>
    <!-- 眼睛（显示密码/查看） -->
    <StreamGeometry x:Key="Apage.Geo.Eye">M2,12 C5,6 9,3 12,3 C15,3 19,6 22,12 C19,18 15,21 12,21 C9,21 5,18 2,12 Z M12,8 A4,4 0 1,0 12,16 A4,4 0 1,0 12,8</StreamGeometry>
    <!-- 闭眼（隐藏） -->
    <StreamGeometry x:Key="Apage.Geo.EyeOff">M3,3 L21,21 M10.6,10.7 A4,4 0 0,0 14,13.3 M6.7,6.7 C3.8,8.8 2,12 2,12 C5,18 9,21 12,21 C13.5,21 15,20.4 16.3,19.6 M19.2,16.2 C20.5,14.7 22,12.7 22,12 C19,6 15,3 12,3 C10.6,3 9.2,3.4 8,4.2</StreamGeometry>
    <!-- 下载进度环（环形，下载中态） -->
    <StreamGeometry x:Key="Apage.Geo.ProgressRing">M12,3 A9,9 0 1,1 3,12</StreamGeometry>

    <!-- ========== 图标 Path 基样式（stroke 跟随 Button 前景） ========== -->
    <Style x:Key="Apage.Style.Icon" TargetType="Path">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="1.9"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Stroke"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </Style>
</ResourceDictionary>
