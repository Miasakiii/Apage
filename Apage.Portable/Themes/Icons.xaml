<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Apage 线性图标库（docs/frontend-design.md §10.5）
        - 全部在 24×24 坐标系描点，stroke 风格（非填充），与走查稿一致。
        - 用法：<Path Style="{StaticResource Apage.Style.Icon}" Data="{StaticResource Apage.Geo.Xxx}"/>
          Stroke 跟随所在 Button 的 Foreground（hover/禁用/关闭红态自动联动）。
        - 需要不同尺寸时在使用处覆盖 Width/Height。
    -->

    <!-- ========== 几何路径（24 viewBox） ========== -->
    <!-- 导航 -->
    <StreamGeometry x:Key="Apage.Geo.Back">M15,5 L8,12 L15,19</StreamGeometry>
    <StreamGeometry x:Key="Apage.Geo.Forward">M9,5 L16,12 L9,19</StreamGeometry>
    <!-- 刷新（Lucide rotate-cw：环 + 右上箭头） -->
    <StreamGeometry x:Key="Apage.Geo.Reload">M21,12 A9,9 0 1 1 18,5.3 L21,8 M21,3 L21,8 L16,8</StreamGeometry>
    <!-- 搜索（圆 + 手柄） -->
    <StreamGeometry x:Key="Apage.Geo.Search">M11,3 A8,8 0 1 0 11,19 A8,8 0 1 0 11,3 M16.7,16.7 L21,21</StreamGeometry>
    <!-- 锁（https） -->
    <StreamGeometry x:Key="Apage.Geo.Lock">M4,11 L20,11 L20,21 L4,21 Z M7,11 L7,7 A5,5 0 0 1 17,7 L17,11</StreamGeometry>
    <!-- 隐私盾 -->
    <StreamGeometry x:Key="Apage.Geo.Shield">M12,3 L19,6 L19,11 C19,15.5 16,18.5 12,20 C8,18.5 5,15.5 5,11 L5,6 Z</StreamGeometry>
    <!-- 下载 -->
    <StreamGeometry x:Key="Apage.Geo.Download">M12,4 L12,15 M7,10 L12,15 L17,10 M5,20 L19,20</StreamGeometry>
    <!-- 脚本 </> -->
    <StreamGeometry x:Key="Apage.Geo.Script">M9,8 L5,12 L9,16 M15,8 L19,12 L15,16</StreamGeometry>
    <!-- 书签（五角星） -->
    <StreamGeometry x:Key="Apage.Geo.Star">M12,3.6 L14.6,9 L20.5,9.8 L16.2,13.9 L17.3,19.8 L12,16.9 L6.7,19.8 L7.8,13.9 L3.5,9.8 L9.4,9 Z</StreamGeometry>
    <!-- 历史（时钟） -->
    <StreamGeometry x:Key="Apage.Geo.History">M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 M12,7 L12,12 L15.5,14</StreamGeometry>
    <!-- 菜单（三横线） -->
    <StreamGeometry x:Key="Apage.Geo.Menu">M4,7 L20,7 M4,12 L20,12 M4,17 L20,17</StreamGeometry>
    <!-- 加号 -->
    <StreamGeometry x:Key="Apage.Geo.Plus">M12,5 L12,19 M5,12 L19,12</StreamGeometry>
    <!-- 关闭 X -->
    <StreamGeometry x:Key="Apage.Geo.Close">M6,6 L18,18 M18,6 L6,18</StreamGeometry>
    <!-- 窗口：最小化 / 最大化 / 还原 -->
    <StreamGeometry x:Key="Apage.Geo.WinMin">M5,12 L19,12</StreamGeometry>
    <StreamGeometry x:Key="Apage.Geo.WinMax">M5,5 L19,5 L19,19 L5,19 Z</StreamGeometry>
    <StreamGeometry x:Key="Apage.Geo.WinRestore">M8,8 L8,5 L19,5 L19,16 L16,16 M5,8 L16,8 L16,19 L5,19 Z</StreamGeometry>

    <!-- ========== 补充图标（2026-11-02 品牌图标扩展，同 24 viewBox stroke 风格） ========== -->
    <!-- 设置（齿轮，Lucide settings） -->
    <StreamGeometry x:Key="Apage.Geo.Settings">M12,15a3,3 0 1,0 0,-6a3,3 0 1,0 0,6z M19.4,15a1.65,1.65 0 0,0 .33,1.82l.06,.06a2,2 0 1,1 -2.83,2.83l-.06,-.06a1.65,1.65 0 0,0 -1.82,-.33a1.65,1.65 0 0,0 -1,1.51V21a2,2 0 1,1 -4,0v-.09a1.65,1.65 0 0,0 -1,-1.51a1.65,1.65 0 0,0 -1.82,.33l-.06,.06a2,2 0 1,1 -2.83,-2.83l.06,-.06a1.65,1.65 0 0,0 .33,-1.82a1.65,1.65 0 0,0 -1.51,-1H3a2,2 0 1,1 0,-4h.09a1.65,1.65 0 0,0 1.51,-1a1.65,1.65 0 0,0 -.33,-1.82l-.06,-.06a2,2 0 1,1 2.83,-2.83l.06,.06a1.65,1.65 0 0,0 1.82,.33H9a1.65,1.65 0 0,0 1,-1.51V3a2,2 0 1,1 4,0v.09a1.65,1.65 0 0,0 1,1.51a1.65,1.65 0 0,0 1.82,-.33l.06,-.06a2,2 0 1,1 2.83,2.83l-.06,.06a1.65,1.65 0 0,0 -.33,1.82V9a1.65,1.65 0 0,0 1.51,1H21a2,2 0 1,1 0,4h-.09a1.65,1.65 0 0,0 -1.51,1z</StreamGeometry>
    <!-- 壁纸/图片（矩形+山+太阳） -->
