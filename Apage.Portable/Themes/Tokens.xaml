<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        Apage 设计令牌（对应 docs/frontend-design.md §4）
        - 主题相关的「色值」（窗口底/卡片底/hover/文字/边框）定义在 Light.xaml / Dark.xaml，
          此处画刷经 DynamicResource 引用颜色，切换主题字典即整体换肤。
        - 强调色与语义色深浅主题通用，直接定义在本字典。
    -->

    <!-- ========== §4.1 颜色（主题无关） ========== -->
    <Color x:Key="Apage.Color.Accent">#3B82F6</Color>
    <Color x:Key="Apage.Color.AccentHover">#2563EB</Color>
    <Color x:Key="Apage.Color.AccentPressed">#1D4ED8</Color>
    <Color x:Key="Apage.Color.AccentSoft">#1F3B82F6</Color><!-- rgba(59,130,246,.12) -->
    <Color x:Key="Apage.Color.Shield">#22C55E</Color>
    <Color x:Key="Apage.Color.Danger">#EF4444</Color>
    <Color x:Key="Apage.Color.Warning">#F59E0B</Color>

    <!-- ========== 画刷（统一前缀 Apage.Brush.） ========== -->
    <SolidColorBrush x:Key="Apage.Brush.Accent" Color="{DynamicResource Apage.Color.Accent}"/>
    <SolidColorBrush x:Key="Apage.Brush.AccentHover" Color="{DynamicResource Apage.Color.AccentHover}"/>
    <SolidColorBrush x:Key="Apage.Brush.AccentPressed" Color="{DynamicResource Apage.Color.AccentPressed}"/>
    <SolidColorBrush x:Key="Apage.Brush.AccentSoft" Color="{DynamicResource Apage.Color.AccentSoft}"/>
    <SolidColorBrush x:Key="Apage.Brush.Shield" Color="{DynamicResource Apage.Color.Shield}"/>
    <SolidColorBrush x:Key="Apage.Brush.Danger" Color="{DynamicResource Apage.Color.Danger}"/>
    <SolidColorBrush x:Key="Apage.Brush.Warning" Color="{DynamicResource Apage.Color.Warning}"/>

    <!-- 主题相关画刷：色值由 Light.xaml / Dark.xaml 提供 -->
    <SolidColorBrush x:Key="Apage.Brush.WindowBg" Color="{DynamicResource Apage.Color.WindowBg}"/>
    <SolidColorBrush x:Key="Apage.Brush.Surface" Color="{DynamicResource Apage.Color.Surface}"/>
    <SolidColorBrush x:Key="Apage.Brush.Hover" Color="{DynamicResource Apage.Color.Hover}"/>
    <SolidColorBrush x:Key="Apage.Brush.Pressed" Color="{DynamicResource Apage.Color.Pressed}"/>
    <SolidColorBrush x:Key="Apage.Brush.TextPrimary" Color="{DynamicResource Apage.Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Apage.Brush.TextSecondary" Color="{DynamicResource Apage.Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Apage.Brush.TextTertiary" Color="{DynamicResource Apage.Color.TextTertiary}"/>
    <SolidColorBrush x:Key="Apage.Brush.Border" Color="{DynamicResource Apage.Color.Border}"/>

    <!-- ========== §4.2 字号（族：Segoe UI Variable / Microsoft YaHei UI 系统回落） ========== -->
    <FontFamily x:Key="Apage.FontFamily.Base">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <sys:Double x:Key="Apage.FontSize.Xs">11</sys:Double>
    <sys:Double x:Key="Apage.FontSize.Sm">12</sys:Double>
    <sys:Double x:Key="Apage.FontSize.Base">13</sys:Double>
    <sys:Double x:Key="Apage.FontSize.Md">15</sys:Double>
    <sys:Double x:Key="Apage.FontSize.Lg">20</sys:Double>
    <sys:Double x:Key="Apage.FontSize.Clock">56</sys:Double><!-- 新标签页时钟，使用时 FontWeight=UltraLight(200) -->

    <!-- ========== §4.3 圆角 ========== -->
    <CornerRadius x:Key="Apage.CornerRadius.Sm">4</CornerRadius>
    <CornerRadius x:Key="Apage.CornerRadius.Md">8</CornerRadius>
    <CornerRadius x:Key="Apage.CornerRadius.Lg">12</CornerRadius>
    <CornerRadius x:Key="Apage.CornerRadius.Pill">999</CornerRadius>

    <!-- ========== §4.3 间距（4px 网格） ========== -->
    <sys:Double x:Key="Apage.Spacing.1">4</sys:Double>
    <sys:Double x:Key="Apage.Spacing.2">8</sys:Double>
    <sys:Double x:Key="Apage.Spacing.3">12</sys:Double>
    <sys:Double x:Key="Apage.Spacing.4">16</sys:Double>
    <sys:Double x:Key="Apage.Spacing.5">24</sys:Double>
    <sys:Double x:Key="Apage.Spacing.6">32</sys:Double>
    <sys:Double x:Key="Apage.Spacing.7">48</sys:Double>

    <!-- ========== §4.3 动效时长（尊重系统「减少动画」设置，开启时应降级为即时切换） ========== -->
    <sys:TimeSpan x:Key="Apage.Duration.Fast">00:00:00.1</sys:TimeSpan><!-- hover 变色 -->
    <sys:TimeSpan x:Key="Apage.Duration.Med">00:00:00.2</sys:TimeSpan><!-- 开合、滑入 -->
    <sys:TimeSpan x:Key="Apage.Duration.Slow">00:00:00.32</sys:TimeSpan><!-- 页面级过渡 -->
    <!-- 缓动：cubic-bezier(.2,.8,.3,1)，先快后稳，禁止线性 -->
    <CubicEase x:Key="Apage.Ease" EasingMode="EaseOut"/>

    <!--
        §4.3 阴影（仅两级；性能红线：禁用 DropShadowEffect，用 Border 描边 + 下边距错位模拟）
        shadow-1: 0 1px 3px rgba(0,0,0,.08)  —— 卡片
        shadow-2: 0 8px 24px rgba(0,0,0,.16) —— 下拉/对话框/Toast
        用法：内容 Border 外套一层 Border，Padding=下方数值，Background=Apage.Brush.Shadow1/2。
    -->
    <Color x:Key="Apage.Color.Shadow1">#14000000</Color>
    <Color x:Key="Apage.Color.Shadow2">#29000000</Color>
    <SolidColorBrush x:Key="Apage.Brush.Shadow1" Color="{DynamicResource Apage.Color.Shadow1}"/>
    <SolidColorBrush x:Key="Apage.Brush.Shadow2" Color="{DynamicResource Apage.Color.Shadow2}"/>
    <Thickness x:Key="Apage.Shadow1.Extent">0,1,3,3</Thickness>
    <Thickness x:Key="Apage.Shadow2.Extent">0,8,24,16</Thickness>
</ResourceDictionary>
