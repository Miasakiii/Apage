<Window x:Class="Apage.Portable.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Apage.Portable.Controls"
        xmlns:views="clr-namespace:Apage.Portable.Views"
        Title="Apage" Width="1024" Height="640" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Apage.Brush.WindowBg}">
    <!--
      窗口外壳（frontend-design.md §5.1）：标签条 36px + 工具栏 44px = 80px。
      WindowChrome 自定义标题栏：标签条空白处即标题区，可拖窗、双击最大化/还原。
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CaptionHeight="36"
                      UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 第 1 行：标签条（36px），右端融入窗口控制按钮 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <controls:TabStrip Grid.Column="0"/>
            <controls:WindowButtons Grid.Column="1"/>
        </Grid>

        <!-- 第 2 行：工具栏（44px），surface 白底与当前标签无缝衔接，底部 1px 分隔线 -->
        <Border Grid.Row="1"
                Background="{DynamicResource Apage.Brush.Surface}"
                BorderBrush="{DynamicResource Apage.Brush.Border}"
                BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：导航三钮 32x32，字符图标占位（后续换 StreamGeometry） -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Width="32" Height="32" Content="←"
                            Style="{DynamicResource Apage.Style.Button.Icon}"
                            ToolTip="后退" Click="BackButton_Click"/>
                    <Button x:Name="ForwardButton" Width="32" Height="32" Content="→" Margin="4,0,0,0"
                            Style="{DynamicResource Apage.Style.Button.Icon}"
                            ToolTip="前进" Click="ForwardButton_Click"/>
                    <Button x:Name="ReloadButton" Width="32" Height="32" Content="⟳" Margin="4,0,0,0"
                            Style="{DynamicResource Apage.Style.Button.Icon}"
                            ToolTip="刷新" Click="ReloadButton_Click"/>
                </StackPanel>

                <!-- 中间：Omnibox 地址栏。
                     契约控件 Apage.Portable.Controls.Omnibox 由其他代理提供，
                     就绪后删除占位并启用下面被注释的一行：
                     <controls:Omnibox Grid.Column="1" x:Name="Omnibox"/> -->
                <Border Grid.Column="1" Height="30" Margin="8,0" CornerRadius="15"
                        Background="{DynamicResource Apage.Brush.Hover}">
                    <TextBlock Text="搜索或输入网址（Omnibox 占位）" FontSize="13"
                               VerticalAlignment="Center" Margin="16,0,0,0"
                               Foreground="{DynamicResource Apage.Brush.TextTertiary}"/>
                </Border>

                <!-- 右侧：🛡 隐私盾 / ⬇ 下载 / 📜 脚本 / ⋯ 菜单 四钮占位 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ShieldButton" Width="32" Height="32" Content="🛡"
                            Style="{DynamicResource Apage.Style.Button.Icon}"
                            ToolTip="隐私盾"/>
                    <Button x:Name="DownloadsButton" Width="32" Height="32" Content="⬇" Margin="4,0,0,0"
                            Style="{DynamicResource Apage.Style.Button.Icon}"
                            ToolTip="下载"/>
                    <Button x:Name="ScriptsButton" Width="32" Height="32" Content="📜" Margin="4,0,0,0"
                            Style="{DynamicResource Apage.Style.Button.Icon}"
                            ToolTip="脚本"/>
                    <Button x:Name="MenuButton" Width="32" Height="32" Content="⋯" Margin="4,0,0,0"
                            Style="{DynamicResource Apage.Style.Button.Icon}"
                            ToolTip="菜单"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 第 3 行：网页内容区（契约控件，导航按钮转发到它） -->
        <views:BrowserTabView Grid.Row="2" x:Name="BrowserView"/>
    </Grid>
</Window>
