<Window x:Class="Apage.Portable.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 — Apage"
        Width="600" Height="640"
        MinWidth="600" MinHeight="640"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Apage.Brush.WindowBg}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="设置"
                       FontSize="{DynamicResource Apage.FontSize.Lg}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Apage.Brush.TextPrimary}"/>
            <TextBlock Text="只展示当前已有真实行为的选项。"
                       Margin="0,4,0,0"
                       FontSize="{DynamicResource Apage.FontSize.Sm}"
                       Foreground="{DynamicResource Apage.Brush.TextSecondary}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 搜索 -->
                <Border Background="{DynamicResource Apage.Brush.Surface}"
                        BorderBrush="{DynamicResource Apage.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Apage.CornerRadius.Md}"
                        Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="搜索"
                                   FontSize="{DynamicResource Apage.FontSize.Md}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Apage.Brush.TextPrimary}"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="地址栏搜索引擎"
                                           Foreground="{DynamicResource Apage.Brush.TextPrimary}"/>
                                <TextBlock Text="即时生效：下一次搜索使用新引擎"
                                           Margin="0,2,0,0"
                                           FontSize="{DynamicResource Apage.FontSize.Xs}"
                                           Foreground="{DynamicResource Apage.Brush.TextTertiary}"/>
                            </StackPanel>
                            <ComboBox x:Name="SearchEngineBox" Grid.Column="1"
                                      Height="30" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Bing" Tag="bing"/>
                                <ComboBoxItem Content="Google" Tag="google"/>
                                <ComboBoxItem Content="DuckDuckGo" Tag="duckduckgo"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 隐私 -->
                <Border Background="{DynamicResource Apage.Brush.Surface}"
                        BorderBrush="{DynamicResource Apage.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Apage.CornerRadius.Md}"
                        Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="隐私"
                                   FontSize="{DynamicResource Apage.FontSize.Md}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Apage.Brush.TextPrimary}"/>

                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                                   FontSize="{DynamicResource Apage.FontSize.Xs}"
                                   Foreground="{DynamicResource Apage.Brush.TextTertiary}"
                                   Text="第三方 Cookie 隔离：当前 WebView2 无可靠阻断入口，本版本不提供该项能力，也不计入追踪统计。"/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="发送 Do Not Track"
                                           Foreground="{DynamicResource Apage.Brush.TextPrimary}"/>
                                <TextBlock Text="声明性请求头 DNT: 1；即时生效"
                                           Margin="0,2,0,0"
                                           FontSize="{DynamicResource Apage.FontSize.Xs}"
                                           Foreground="{DynamicResource Apage.Brush.TextTertiary}"/>
                            </StackPanel>
                            <ToggleButton x:Name="DntToggle" Grid.Column="1"
                                          Style="{StaticResource Apage.Style.Toggle}"
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="发送 Sec-GPC"
                                           Foreground="{DynamicResource Apage.Brush.TextPrimary}"/>
                                <TextBlock Text="声明性请求头 Sec-GPC: 1；即时生效"
                                           Margin="0,2,0,0"
                                           FontSize="{DynamicResource Apage.FontSize.Xs}"
                                           Foreground="{DynamicResource Apage.Brush.TextTertiary}"/>
                            </StackPanel>
                            <ToggleButton x:Name="GpcToggle" Grid.Column="1"
                                          Style="{StaticResource Apage.Style.Toggle}"
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="WebRTC IP 泄露防护"
                                           Foreground="{DynamicResource Apage.Brush.TextPrimary}"/>
                                <TextBlock Text="限制非代理 UDP；重启 Apage 后生效"
                                           Margin="0,2,0,0"
                                           FontSize="{DynamicResource Apage.FontSize.Xs}"
                                           Foreground="{DynamicResource Apage.Brush.Warning}"/>
                            </StackPanel>
                            <ToggleButton x:Name="WebRtcToggle" Grid.Column="1"
                                          Style="{StaticResource Apage.Style.Toggle}"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 拦截规则（A3：手动更新，非后台自动） -->
                <Border Background="{DynamicResource Apage.Brush.Surface}"
                        BorderBrush="{DynamicResource Apage.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Apage.CornerRadius.Md}"
                        Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="拦截规则"
                                   FontSize="{DynamicResource Apage.FontSize.Md}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Apage.Brush.TextPrimary}"/>
                        <TextBlock x:Name="RuleSourceText"
                                   Margin="0,8,0,0" TextWrapping="Wrap"
                                   FontSize="{DynamicResource Apage.FontSize.Sm}"
                                   Foreground="{DynamicResource Apage.Brush.TextPrimary}"/>
                        <TextBlock x:Name="RuleDateText"
                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                   FontSize="{DynamicResource Apage.FontSize.Xs}"
                                   Foreground="{DynamicResource Apage.Brush.TextTertiary}"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                   FontSize="{DynamicResource Apage.FontSize.Xs}"
                                   Foreground="{DynamicResource Apage.Brush.TextTertiary}"
                                   Text="来源 EasyList / EasyPrivacy（CC BY-SA 3.0）。只有点击按钮才通过 HTTPS 下载；筛选、哈希校验与原子替换全部通过才生效，失败保留原规则。Apage 不会后台自动更新。"/>
                        <Button x:Name="UpdateRulesButton"
                                Content="立即更新规则…"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"
                                Click="UpdateRules_Click"/>
                    </StackPanel>
                </Border>

                <!-- 存储 -->
                <Border Background="{DynamicResource Apage.Brush.Surface}"
                        BorderBrush="{DynamicResource Apage.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Apage.CornerRadius.Md}"
                        Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="存储"
                                   FontSize="{DynamicResource Apage.FontSize.Md}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Apage.Brush.TextPrimary}"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="纯便携缓存"
                                           Foreground="{DynamicResource Apage.Brush.TextPrimary}"/>
                                <TextBlock Text="缓存写入程序旁 cache/；默认写 %TEMP%，重启后生效"
                                           Margin="0,2,0,0"
                                           FontSize="{DynamicResource Apage.FontSize.Xs}"
                                           Foreground="{DynamicResource Apage.Brush.Warning}"/>
                                <TextBlock x:Name="CachePathText"
                                           Margin="0,4,0,0"
                                           FontSize="{DynamicResource Apage.FontSize.Xs}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Apage.Brush.TextTertiary}"/>
                            </StackPanel>
                            <ToggleButton x:Name="PortableCacheToggle" Grid.Column="1"
                                          Style="{StaticResource Apage.Style.Toggle}"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 诊断 -->
                <Border Background="{DynamicResource Apage.Brush.Surface}"
                        BorderBrush="{DynamicResource Apage.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Apage.CornerRadius.Md}"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="本地诊断"
                                   FontSize="{DynamicResource Apage.FontSize.Md}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Apage.Brush.TextPrimary}"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                   FontSize="{DynamicResource Apage.FontSize.Sm}"
                                   Foreground="{DynamicResource Apage.Brush.TextSecondary}"
                                   Text="日志仅保存在本机，默认不记录 URL、搜索词、Cookie 或网页内容，不会自动上传。Apage 不发起后台网络请求。"/>
                        <TextBlock x:Name="LogPathText"
                                   Margin="0,6,0,0"
                                   FontSize="{DynamicResource Apage.FontSize.Xs}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Apage.Brush.TextTertiary}"/>
                        <Button x:Name="ExportLogButton"
                                Content="导出诊断日志…"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"
                                Click="ExportLog_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource Apage.FontSize.Sm}"
                       Foreground="{DynamicResource Apage.Brush.TextSecondary}"/>
            <Button Grid.Column="1" Content="取消" Width="88" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="SaveButton" Grid.Column="2" Content="保存" Width="88"
                    IsDefault="True" Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>
